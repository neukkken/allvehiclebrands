{
  "name": "vehicle-brands",
  "version": "1.0.0",
  "description": "A comprehensive list of global car and motorcycle brands with metadata (country, type, status, corporate group)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "vehicles",
    "cars",
    "motorcycles",
    "brands",
    "automotive",
    "manufacturers",
    "makes"
  ],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
